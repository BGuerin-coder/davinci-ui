{
  "name": "@bguerin/davinci-ui",
  "version": "0.1.2",
  "description": "A modern, accessible Vue3 component library inspired by Leonardo da Vinci",
  "author": "Benjamin Guerin",
  "license": "MIT",
  "homepage": "https://github.com/BGuerin-coder/davinci-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BGuerin-coder/davinci-ui.git"
  },
  "type": "module",
  "main": "./dist/davinci-ui.js",
  "types": "./dist/davinci-ui.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/davinci-ui.js",
      "types": "./dist/davinci-ui.d.ts"
    },
    "./style.css": "./dist/davinci-ui.css"
  },
  "keywords": [
    "vue3",
    "components",
    "ui",
    "design-system",
    "typescript"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "lint": "eslint --ext .ts,.vue src",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest --coverage",
    "test-storybook": "vitest --project=storybook --coverage"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.2",
    "@eslint/css": "^1.2.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.3.1",
    "@storybook/addon-docs": "^10.3.1",
    "@storybook/addon-onboarding": "^10.3.1",
    "@storybook/addon-themes": "^10.3.1",
    "@storybook/addon-vitest": "^10.3.1",
    "@storybook/test": "^8.6.15",
    "@storybook/vue3-vite": "^10.3.1",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "chromatic": "^16.6.3",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.8.7",
    "jiti": "^2.6.1",
    "playwright": "^1.58.2",
    "storybook": "^10.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.5"
  }
}
